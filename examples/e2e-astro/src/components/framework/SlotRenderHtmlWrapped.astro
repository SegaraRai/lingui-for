---
import { style } from "stillwind/astro";

interface Props {
  label: string;
}

const { label } = Astro.props;
const html = await Astro.slots.render("default");
const wrapper = style("contents");
const wrappedHtml = `<div class="${wrapper.class}">${html}</div>`;
---

<section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
  <div {...style("card-body gap-4")}>
    <h2 {...style("card-title")}>{label}</h2>
    <Fragment set:html={wrappedHtml} />
  </div>
</section>
