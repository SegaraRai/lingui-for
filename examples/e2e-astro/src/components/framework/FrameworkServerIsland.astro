---
import { style } from "stillwind/astro";

interface Props {
  label: string;
  mode: string;
}

const { label, mode } = Astro.props;
---

<section
  {...style("rounded-box p-4 border border-base-300")}
  data-testid={`framework-server-${mode}-content`}
>
  <p data-testid={`framework-server-${mode}-label`}>{label}</p>
</section>
