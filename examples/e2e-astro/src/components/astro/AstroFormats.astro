---
import { style } from "stillwind/astro";
import {
  Plural,
  plural,
  Select,
  select,
  SelectOrdinal,
  selectOrdinal,
  t,
} from "lingui-for-astro/macro";
---

<section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
  <div {...style("card-body")}>
    <p {...style("badge badge-outline badge-accent flex-none")}>
      {t`Astro formats`}
    </p>
    <h2 {...style("card-title")}>
      {t`Astro runs plural, select, and selectOrdinal macros in component code.`}
    </h2>

    <p {...style("text-base-content/70")}>
      <Plural
        value={3}
        one="# Astro format sample"
        other="# Astro format samples"
      />
    </p>
    <p {...style("text-base-content/70")}>
      <Select
        value="excited"
        _calm="Astro select says calm."
        _excited="Astro select says excited."
        other="Astro select says unknown."
      />
    </p>
    <p {...style("text-base-content/70")}>
      <SelectOrdinal
        value={2}
        one="Astro finished #st."
        two="Astro finished #nd."
        few="Astro finished #rd."
        other="Astro finished #th."
      />
    </p>

    <hr {...style("divider")} />
    <p {...style("text-base-content/70")}>
      {plural(3, {
        one: "# Astro format sample",
        other: "# Astro format samples",
      })}
    </p>
    <p {...style("text-base-content/70")}>
      {select("excited", {
        calm: "Astro select says calm.",
        excited: "Astro select says excited.",
        other: "Astro select says unknown.",
      })}
    </p>
    <p {...style("text-base-content/70")}>
      {selectOrdinal(2, {
        one: "Astro finished #st.",
        two: "Astro finished #nd.",
        few: "Astro finished #rd.",
        other: "Astro finished #th.",
      })}
    </p>
  </div>
</section>
