---
import { style } from "stillwind/astro";
import { t } from "lingui-for-astro/macro";

import AppLayout from "../layouts/AppLayout.astro";
import { getLocaleLabel } from "../lib/i18n/runtime";

const locale = Astro.locals.locale;
const localeLabel = getLocaleLabel(locale);
const currentPage = t`Overview`;
---

<AppLayout
  title={t`Lingui Astro multi-page playground`}
  locale={locale}
  pathname={Astro.url.pathname}
  currentPage={currentPage}
>
  <section
    {...style("hero rounded-box bg-base-100 border border-base-300 shadow-xl")}
  >
    <div {...style("hero-content px-6 py-10 justify-start")}>
      <div {...style("space-y-4")}>
        <p {...style("badge badge-outline badge-primary flex-none")}>
          {t`Overview`}
        </p>
        <h1 {...style("font-black text-4xl tracking-tight sm:text-5xl")}>
          {t`One Astro app, several translation checkpoints`}
        </h1>
        <p {...style("text-base-content/70")}>
          {t`Each page isolates one concern so regressions are easier to spot.`}
        </p>
        <p {...style("badge badge-secondary badge-lg flex-none")}>
          {t`Server locale: ${localeLabel}`}
        </p>
      </div>
    </div>
  </section>

  <div {...style("grid gap-4 lg:grid-cols-2 xl:grid-cols-3")}>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Server translations`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Check request-scoped Astro translations and shared layout text.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/server">
            /server
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Framework routes`}
        </p>
        <h2 {...style("card-title")}>
          {t`Astro framework interpolation behavior`}
        </h2>
        <p {...style("text-base-content/70")}>
          {t`Confirm which interpolation forms Astro accepts before Lingui transforms run.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a
            {...style("btn btn-primary btn-sm")}
            href="/framework/interpolation"
          >
            /framework/interpolation
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Framework islands`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Render Svelte and React islands with the same locale.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/islands">
            /islands
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Rich text messages`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Verify linked and emphasized translations across runtimes.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/rich-text">
            /rich-text
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Message formats`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Exercise plural, select, and selectOrdinal macros.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/formats">
            /formats
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Astro interpolation edge cases`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Check translated Astro interpolations that contain comments and fragments.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/interpolation">
            /interpolation
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Dynamic routing`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Confirm route params and locale cookies survive navigation.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/routing/alpha">
            /routing/alpha
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Locale persistence`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Use cookies to keep the next request aligned.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/settings">
            /settings
          </a>
        </div>
      </div>
    </section>
    <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
      <div {...style("card-body")}>
        <p {...style("badge badge-outline badge-accent flex-none")}>
          {t`Verification routes`}
        </p>
        <h2 {...style("card-title")}>{t`Client transitions`}</h2>
        <p {...style("text-base-content/70")}>
          {t`Compare whether persisted Svelte and React islands keep state while locale and page props still update.`}
        </p>
        <div {...style("card-actions justify-end")}>
          <a {...style("btn btn-primary btn-sm")} href="/transitions">
            /transitions
          </a>
        </div>
      </div>
    </section>
  </div>
</AppLayout>
