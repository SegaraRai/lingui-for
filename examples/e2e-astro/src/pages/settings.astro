---
import { style } from "stillwind/astro";
import { t, Trans } from "lingui-for-astro/macro";

import AppLayout from "../layouts/AppLayout.astro";
import { getLocaleLabel } from "../lib/i18n/runtime";

const locale = Astro.locals.locale;
const localeLabel = getLocaleLabel(locale);
const currentPage = t`Settings page`;
---

<AppLayout
  title={t`Language settings`}
  locale={locale}
  pathname={Astro.url.pathname}
  currentPage={currentPage}
>
  <section {...style("card bg-base-100 border border-base-300 shadow-xl")}>
    <div {...style("card-body gap-4")}>
      <p {...style("badge badge-outline badge-primary flex-none")}>
        {t`Settings`}
      </p>
      <h1 {...style("font-black text-3xl tracking-tight")}>
        {t`Language settings`}
      </h1>
      <p {...style("text-base-content/70")}>
        {t`The locale is stored in a cookie so the next request stays consistent.`}
      </p>
      <p {...style("badge badge-secondary badge-lg flex-none")}>
        {t`Current locale: ${localeLabel}`}
      </p>
      <p {...style("text-base-content/70")}>
        <Trans>
          Return to the{" "}
          <a class="link link-primary" href="/">
            home page
          </a>{" "}
          when you are done.
        </Trans>
      </p>
      <ul {...style("space-y-2 pl-5 list-disc text-base-content/70")}>
        <li>{t`Astro uses request-scoped locals.`}</li>
        <li>{t`Svelte activates Lingui inside its island.`}</li>
        <li>{t`React reads Lingui through an I18nProvider.`}</li>
      </ul>
    </div>
  </section>
</AppLayout>
