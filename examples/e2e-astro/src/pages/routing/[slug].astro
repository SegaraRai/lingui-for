---
import { style } from "stillwind/astro";
import { t, Trans } from "lingui-for-astro/macro";

import AppLayout from "../../layouts/AppLayout.astro";

const locale = Astro.locals.locale;
const slug = Astro.params.slug ?? "unknown";
const currentPage = t`Routing page`;
const alternateSlug = slug === "alpha" ? "beta" : "alpha";
---

<AppLayout
  title={t`Dynamic route checks`}
  locale={locale}
  pathname={Astro.url.pathname}
  currentPage={currentPage}
>
  <section {...style("card bg-base-100 border border-base-300 shadow-xl")}>
    <div {...style("card-body gap-4")}>
      <p {...style("badge badge-outline badge-primary flex-none")}>
        {t`Routing`}
      </p>
      <h1 {...style("font-black text-3xl tracking-tight")}>
        {t`Dynamic routes can translate with params from Astro.url and route data.`}
      </h1>
      <p {...style("text-base-content/70")}>
        {t`Now viewing the slug ${slug}.`}
      </p>
      <p {...style("text-base-content/70")}>
        {t`The locale cookie still applies here, so the translated page matches the previous request.`}
      </p>
      <p {...style("text-base-content/70")}>
        <Trans>
          Switch to the{" "}
          <a class="link link-primary" href={`/routing/${alternateSlug}`}>
            second route
          </a>{" "}
          without dropping the locale.
        </Trans>
      </p>
    </div>
  </section>
</AppLayout>
