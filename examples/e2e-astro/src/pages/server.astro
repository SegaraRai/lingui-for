---
import { style } from "stillwind/astro";
import { t } from "lingui-for-astro/macro";

import AppLayout from "../layouts/AppLayout.astro";
import { getLocaleLabel } from "../lib/i18n/runtime";

const locale = Astro.locals.locale;
const localeLabel = getLocaleLabel(locale);
const currentPage = t`Server page`;
---

<AppLayout
  title={t`Server translation checks`}
  locale={locale}
  pathname={Astro.url.pathname}
  currentPage={currentPage}
>
  <section {...style("card bg-base-100 border border-base-300 shadow-xl")}>
    <div {...style("card-body gap-4")}>
      <p {...style("badge badge-outline badge-primary flex-none")}>
        {t`Server`}
      </p>
      <h1 {...style("font-black text-3xl tracking-tight")}>
        {t`Astro pages render request-scoped translations through locals.`}
      </h1>
      <p {...style("text-base-content/70")}>
        {t`The layout, page body, and locale badge all resolve from the request-bound Lingui instance.`}
      </p>
    </div>
  </section>

  <section {...style("card bg-base-100 border border-base-300 shadow-lg")}>
    <div {...style("card-body")}>
      <h2 {...style("card-title")}>
        {t`This paragraph was translated directly inside a .astro page.`}
      </h2>
      <p {...style("text-base-content/70")}>
        {t`The current locale label is ${localeLabel}, and it comes from the same request.`}
      </p>
    </div>
  </section>
</AppLayout>
