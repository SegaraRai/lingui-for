---
import { style } from "stillwind/astro";
import { t } from "lingui-for-astro/macro";

import AppLayout from "../layouts/AppLayout.astro";
import ReactLinguiIsland from "../components/react/ReactLinguiIsland.tsx";
import SvelteLinguiIsland from "../components/svelte/SvelteLinguiIsland.svelte";
import {
  sharedImportedDescriptor,
  sharedImportedDetailDescriptor,
} from "../lib/i18n/shared-descriptors";

const locale = Astro.locals.locale;
const currentPage = t`Islands page`;
---

<AppLayout
  title={t`Island translation checks`}
  locale={locale}
  pathname={Astro.url.pathname}
  currentPage={currentPage}
>
  <section {...style("card bg-base-100 border border-base-300 shadow-xl")}>
    <div {...style("card-body gap-4")}>
      <p {...style("badge badge-outline badge-primary flex-none")}>
        {t`Islands`}
      </p>
      <h1 {...style("font-black text-3xl tracking-tight")}>
        {t`Svelte and React islands read the same active locale.`}
      </h1>
      <p {...style("text-base-content/70")}>
        {t`Each island creates its own runtime, but Astro middleware hands both the same locale.`}
      </p>
      <p {...style("text-base-content/70")}>{t(sharedImportedDescriptor)}</p>
      <p {...style("text-base-content/70")}>
        {t(sharedImportedDetailDescriptor)}
      </p>
    </div>
  </section>

  <div {...style("grid gap-4 lg:grid-cols-2")}>
    <SvelteLinguiIsland client:load locale={locale} />
    <ReactLinguiIsland client:load locale={locale} />
  </div>
</AppLayout>
