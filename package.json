{
  "name": "lingui-for-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:e2e-svelte": "vp run --filter e2e-svelte dev",
    "dev:e2e-astro": "vp run --filter e2e-astro dev",
    "dev:docs": "vp run --filter docs dev",
    "preview:e2e-svelte": "vp run --filter e2e-svelte preview",
    "preview:e2e-astro": "vp run --filter e2e-astro preview",
    "preview:docs": "vp run --filter docs preview",
    "test:rust": "cargo test",
    "changeset": "changeset",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@stillwind/cli": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "stillwind": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wasm-pack": "^0.15.1"
  },
  "packageManager": "pnpm@12.2.1"
}
