---
import { style } from "stillwind/astro";

interface TabItem {
  label: string;
  selected: boolean;
  value: string;
}

interface Props {
  ariaLabel: string;
  group: string;
  tabs: readonly TabItem[];
}

const { ariaLabel, group, tabs } = Astro.props;
---

<div {...style("overflow-x-auto overscroll-x-contain w-full")}>
  <div
    {...style("relative flex min-w-max", {
      "after:": "absolute inset-x-0 inset-be-0 border-panel-border border-b-2",
    })}
    role="tablist"
    aria-label={ariaLabel}
    data-tab-bar
  >
    {tabs.map((tab) => (
      <button
        type="button"
        role="tab"
        tabindex={tab.selected ? 0 : -1}
        aria-selected={tab.selected}
        data-tab-group={group}
        data-tab-value={tab.value}
        {...style(
          "relative px-4 py-3 text-panel-text text-sm whitespace-nowrap transition-colors enabled:cursor-pointer",
          {
            "after:":
              "absolute inset-x-0 inset-be-0 z-1 border-transparent border-b-2",
            "aria-selected:":
              "text-panel-strong font-medium after:border-panel-accent",
          },
        )}
      >
        {tab.label}
      </button>
    ))}
  </div>
</div>

<script>
  const tabBars = document.querySelectorAll<HTMLElement>("[data-tab-bar]");
  for (const tabBar of tabBars) {
    tabBar.addEventListener("keydown", (event) => {
      if (event.defaultPrevented) {
        return;
      }

      const target = event.target;
      if (
        !(target instanceof HTMLElement) ||
        target.getAttribute("role") !== "tab"
      ) {
        return;
      }

      const tabs = Array.from(
        tabBar.querySelectorAll<HTMLElement>(
          `[role="tab"][data-tab-group="${target.dataset.tabGroup}"]`,
        ),
      );
      const currentIndex = tabs.indexOf(target);
      if (currentIndex === -1) {
        return;
      }

      let newIndex: number | null = null;
      switch (event.key) {
        case "ArrowRight":
          newIndex = (currentIndex + 1) % tabs.length;
          break;
        case "ArrowLeft":
          newIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          break;
        case "Home":
          newIndex = 0;
          break;
        case "End":
          newIndex = tabs.length - 1;
          break;
      }

      if (newIndex !== null) {
        event.preventDefault();

        tabs[newIndex].focus();
        tabs[newIndex].click();
      }
    });
  }
</script>
