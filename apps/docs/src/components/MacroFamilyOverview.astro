---
import { Code } from "astro/components";
import { Trans } from "lingui-for-astro/macro";
import { style } from "stillwind/astro";

import { ensureDocsLinguiContext, type DocsLocale } from "../lib/docs-i18n";
import { sourceCodeThemes } from "../lib/code-themes.ts";
import type { MacroFamilyOverviewItem } from "../lib/macro-family-overview.ts";

interface Props {
  language: DocsLocale;
  items: readonly MacroFamilyOverviewItem[];
  title: string;
}

const { language, items, title } = Astro.props;

ensureDocsLinguiContext(Astro.locals, language);

const initialIndex = 0;

const sectionHeader = style("px-5 py-3 border-panel-border border-b");
---

<div class="twp">
  <div
    {...style("overflow-hidden my-6 bg-panel border border-panel-border", {
      class: "not-content",
    })}
    data-family-overview
  >
    <div {...style("px-4 py-3 border-panel-border border-b")}>
      <div {...style("text-panel-label caption")}>{title}</div>
    </div>

    <div {...style("grid gap-0 lg:grid-cols-[15rem_minmax(0,1fr)]")}>
      <aside
        {...style(
          "overflow-hidden bg-panel-muted border-panel-border border-b lg:border-r lg:border-b-0",
        )}
      >
        <div
          {...style("overflow-x-auto overscroll-x-contain lg:overflow-visible")}
        >
          <div {...style("flex min-w-max flex-row lg:min-w-0 lg:flex-col")}>
            {items.map((item, index) => (
              <button
                type="button"
                {...style(
                  "px-4 py-3 text-left border-panel-border border-r border-b transition-colors last:border-r-0 enabled:cursor-pointer lg:border-r-0 lg:last:border-b-0",
                  "aria-pressed:text-panel-strong aria-pressed:bg-panel-selected",
                )}
                tabindex={index === initialIndex ? 0 : -1}
                aria-pressed={index === initialIndex ? "true" : "false"}
                data-family-tab
                data-value={item.value}
              >
                <div {...style("text-sm font-semibold")}>{item.label}</div>
                <div {...style("mt-1 max-w-52 text-panel-label text-xs/5")}>
                  {item.description}
                </div>
              </button>
            ))}
          </div>
        </div>
      </aside>

      <section {...style("grid min-h-80 grid-rows-[auto_minmax(0,1fr)_auto]")}>
        {items.map((item, index) => (
          <article
            {...style(
              "grid col-start-1 row-start-1 row-end-4 grid-rows-subgrid",
              "aria-hidden:invisible aria-hidden:pointer-events-none",
            )}
            data-family-panel
            data-value={item.value}
            aria-hidden={index === initialIndex ? "false" : "true"}
          >
            <div {...style("px-5 py-4 border-panel-border border-b")}>
              <div {...style("text-base text-panel-strong font-semibold")}>
                {item.label}
              </div>
              <div {...style("mt-1 text-panel-label text-sm/6")}>
                {item.description}
              </div>
            </div>

            <div
              {...style(
                "grid h-full grid-rows-[1fr_auto] gap-0 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]",
              )}
            >
              <div
                {...style(
                  "flex h-full flex-col border-panel-border border-b lg:border-r lg:border-b-0",
                )}
              >
                <div {...style(sectionHeader)}>
                  <div {...style("text-panel-label caption")}>
                    <Trans>Preview</Trans>
                  </div>
                </div>
                <div
                  {...style("p-5 flex-1 text-base/7 text-panel-strong")}
                  translate="no"
                >
                  {item.preview}
                </div>
              </div>

              <div {...style("flex h-full min-h-0 flex-col bg-panel")}>
                <div {...style(sectionHeader)}>
                  <div {...style("text-panel-label caption")}>
                    <Trans>Snippet</Trans>
                  </div>
                </div>
                <div {...style("grid flex-1 code-artifact")}>
                  <Code
                    code={item.snippet}
                    lang={item.snippetLang}
                    themes={sourceCodeThemes}
                    defaultColor="light"
                    wrap
                  />
                </div>
              </div>
            </div>

            <div
              {...style(
                "px-5 py-3 bg-panel-muted border-panel-border border-t",
              )}
            >
              <a
                {...style(
                  "text-panel-accent text-sm font-medium hover:underline",
                )}
                href={item.href}
              >
                <Trans>See full demo</Trans>
              </a>
            </div>
          </article>
        ))}
      </section>
    </div>
  </div>
</div>

<script>
  const initMacroFamilyOverview = (root: HTMLElement) => {
    if (root.dataset.initialized === "1") {
      return;
    }

    root.dataset.initialized = "1";

    root.addEventListener("click", (event) => {
      if (event.defaultPrevented) {
        return;
      }

      const target = event.target;
      if (!(target instanceof HTMLElement)) {
        return;
      }

      const button = target.closest("[data-family-tab]");
      if (!(button instanceof HTMLElement)) {
        return;
      }

      const nextValue = button.dataset.value;
      if (!nextValue) {
        return;
      }

      root.querySelectorAll<HTMLElement>("[data-family-tab]").forEach((tab) => {
        const isActive = tab.dataset.value === nextValue;
        tab.ariaPressed = isActive ? "true" : "false";
        tab.tabIndex = isActive ? 0 : -1;

        if (isActive) {
          queueMicrotask(() => {
            tab.scrollIntoView({
              block: "nearest",
              inline: "nearest",
              behavior: "smooth",
            });
          });
        }
      });

      root
        .querySelectorAll<HTMLElement>("[data-family-panel]")
        .forEach((panel) => {
          const isActive = panel.dataset.value === nextValue;
          panel.ariaHidden = isActive ? "false" : "true";
        });
    });

    root.addEventListener("keydown", (event) => {
      if (event.defaultPrevented) {
        return;
      }

      const target = event.target;
      if (!(target instanceof HTMLElement)) {
        return;
      }

      const button = target.closest("[data-family-tab]");
      if (!(button instanceof HTMLElement)) {
        return;
      }

      const tabs = Array.from(
        root.querySelectorAll<HTMLElement>("[data-family-tab]"),
      );
      const currentIndex = tabs.indexOf(button);
      if (currentIndex === -1) {
        return;
      }

      let newIndex: number | null = null;
      switch (event.key) {
        case "ArrowDown":
        case "ArrowRight":
          newIndex = (currentIndex + 1) % tabs.length;
          break;
        case "ArrowUp":
        case "ArrowLeft":
          newIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          break;
        case "Home":
          newIndex = 0;
          break;
        case "End":
          newIndex = tabs.length - 1;
          break;
      }

      if (newIndex !== null) {
        event.preventDefault();

        tabs[newIndex].focus();
        tabs[newIndex].click();
      }
    });
  };

  document.querySelectorAll("[data-family-overview]").forEach((root) => {
    if (root instanceof HTMLElement) {
      initMacroFamilyOverview(root);
    }
  });
</script>
